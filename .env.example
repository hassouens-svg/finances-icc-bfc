# --- Appwrite ---
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6aff0a8e000191faf698
# Clé API serveur (Appwrite > Clés API). Ne jamais la préfixer par NEXT_PUBLIC_.
APPWRITE_API_KEY=

# --- Application ---
# URL publique de l'app (liens de suivi, emails, QR codes)
APP_URL=http://localhost:3000
# Secret pour signer les cookies de session : openssl rand -hex 32
SESSION_SECRET=
# Clé de chiffrement des coordonnées bancaires (32 octets en hex) : openssl rand -hex 32
DATA_ENCRYPTION_KEY=
# Email du super administrateur créé par `npm run seed`
SUPERADMIN_EMAIL=
# Autoriser `npm run seed` (mettre false en production)
ALLOW_SEED=true
